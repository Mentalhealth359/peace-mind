#: templates/mentalhealth/_help_lines.html
msgid "今すぐ、だれかと話したいとき"
msgstr "If you need to talk to someone right now"

#: templates/mentalhealth/_help_lines.html
msgid "つらくて仕方がないとき、消えてしまいたいと感じたときは、電話で話を聞いてもらえます。あなたが連絡していい場所です。"
msgstr "When things feel unbearable, or you feel like disappearing, you can call and someone will listen. You are welcome to reach out."

#: templates/mentalhealth/_help_lines.html
msgid "よりそいホットライン"
msgstr "Yorisoi Hotline"

#: templates/mentalhealth/_help_lines.html
msgid "24時間・無料"
msgstr "24 hours, free"

#: templates/mentalhealth/_help_lines.html
msgid "（外国語での相談は、音声案内で2番）"
msgstr " (for languages other than Japanese, press 2 at the voice guide)"

#: templates/mentalhealth/_help_lines.html
msgid "いのちの電話（ナビダイヤル）"
msgstr "Inochi no Denwa (Lifeline)"

#: templates/mentalhealth/_help_lines.html
msgid "受付時間は公式サイトでご確認ください"
msgstr "Please check the official website for hours"

#: templates/mentalhealth/_help_lines.html
msgid "こころの健康相談統一ダイヤル"
msgstr "Mental Health Consultation Dial"

#: templates/mentalhealth/_help_lines.html
msgid "お住まいの地域の窓口につながります"
msgstr "Connects you to the office in your area"

#: templates/mentalhealth/_help_lines.html
msgid "命の危険がある緊急時は、119 に電話してください。"
msgstr "If a life is in danger, call 119."

