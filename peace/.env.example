# このファイルをコピーして .env という名前で保存し、値を書き換えてください。
#   cp .env.example .env
# .env は .gitignore 済みなので、実際の値をコミットしてしまう心配はありません。

# --- メール送信（Gmail SMTP）設定 ---
# 未設定のままなら開発用のコンソール出力（ターミナル表示のみ）にフォールバックします。

# Gmailアカウント（2段階認証を有効にし、アプリパスワードを発行しておくこと）
# 個人のアドレスではなく、システム専用のアカウント（例: peacemind.noreply@gmail.com）を使うこと。
# 通知・パスワード再設定メールは全てこのアドレスから送られるため、学生・先生全員に見えます。
EMAIL_HOST_USER=your_account@gmail.com

# 通常のログインパスワードではなく、16桁の「アプリパスワード」を入れる
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx

# 送信元として表示されるアドレス。省略時は EMAIL_HOST_USER と同じになる
DEFAULT_FROM_EMAIL=your_account@gmail.com

# --- 公開URL ---
# メール内のリンク（パスワード再設定・新着通知）の組み立てに使う。末尾の / は不要。
SITE_BASE_URL=http://127.0.0.1:8000

# ==========================================
# 本番用（python run.py prod で使う。開発中は空のままでよい）
# ==========================================
# 鍵は python run.py genkey で作れる

# Django の秘密鍵（本番では必須）
DJANGO_SECRET_KEY=

# 公開するドメイン。カンマ区切り（本番では必須）
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# フォームの送信元チェック用。https:// から書く
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# 学生情報の暗号化キー（本番では必須）。
# 開発中のデータを引き継ぐなら field_encryption.key の中身をそのまま入れる
FIELD_ENCRYPTION_KEY=

# HTTPS で公開するなら 1（既定）。HTTPS なしで本番設定を試すときだけ 0
DJANGO_HTTPS=1

# HSTS の秒数。最初は 3600（1時間）で様子を見て、問題なければ 31536000（1年）に上げる
DJANGO_HSTS_SECONDS=3600

# --- Cloudflare Tunnel ---
# 本番は Cloudflare Tunnel 経由でだけ公開する。サーバーは 127.0.0.1:8000 でだけ待ち受けるので、
# トンネル（同じマシンの cloudflared）以外からは直接つながらない。
# cloudflared の設定（config.yml）の service は http://127.0.0.1:8000 にする。
#
# cloudflared が接続してくるIP。空なら 127.0.0.1（同じマシンで動かす場合はこのまま）。
# cloudflared を別のマシンや Docker コンテナで動かすときだけ、そのIPを書く。
WAITRESS_TRUSTED_PROXY=

# 待ち受けるアドレス。空なら 127.0.0.1。0.0.0.0 にするとトンネルを通さず直接アクセスできてしまうので変えない。
WAITRESS_HOST=
