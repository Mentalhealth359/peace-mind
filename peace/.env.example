# このファイルをコピーして .env という名前で保存し、値を書き換えてください。
#   cp .env.example .env
# .env は .gitignore 済みなので、実際の値をコミットしてしまう心配はありません。

# --- メール送信（Gmail SMTP）設定 ---
# 未設定のままなら開発用のコンソール出力（ターミナル表示のみ）にフォールバックします。

# Gmailアカウント（2段階認証を有効にし、アプリパスワードを発行しておくこと）
# 個人のアドレスではなく、システム専用のアカウント（例: peacemind.noreply@gmail.com）を使うこと。
# 通知・パスワード再設定メールは全てこのアドレスから送られるため、学生・先生全員に見えます。
EMAIL_HOST_USER=your_account@gmail.com

# 通常のログインパスワードではなく、16桁の「アプリパスワード」を入れる
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx

# 送信元として表示されるアドレス。省略時は EMAIL_HOST_USER と同じになる
DEFAULT_FROM_EMAIL=your_account@gmail.com

# --- 公開URL ---
# メール内のリンク（パスワード再設定・新着通知）の組み立てに使う。末尾の / は不要。
SITE_BASE_URL=http://127.0.0.1:8000
